---
import { renderMonthContents } from '../utils/availabilityMonth';
interface Props { month: string; locale: 'pl' | 'en'; today: string; }
const { month, locale, today } = Astro.props;
---
<section class="kc-month" data-month={month} aria-labelledby={`month-${month}`} set:html={renderMonthContents(month, locale, today)} />
