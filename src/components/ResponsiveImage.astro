---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: string;
  alt: string;
  width?: number | string;
  height?: number | string;
  sizes?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  decoding?: 'async' | 'sync' | 'auto';
  class?: string;
  fit?: 'cover' | 'contain';
}
const { src, alt, sizes = '(max-width: 600px) calc(100vw - 40px), (max-width: 900px) 45vw, 350px', loading = 'lazy', fit = 'cover', ...attributes } = Astro.props;
const sources = import.meta.glob<{ default: ImageMetadata }>('/public/images/*.{jpg,jpeg,JPG,JPEG,png,webp}', { eager: true });
const source = sources['/public' + decodeURI(src)]?.default;
const widths = source ? [...new Set([360, 640, 960, 1440, Math.min(source.width, 1800)].filter(w => w <= source.width))].sort((a,b) => a-b) : [];
const variants = source ? await Promise.all(widths.map(width => getImage({ src:source, width, format:'webp', quality:78 }))) : [];
const fallback = variants.find(v => Number(v.attributes.width) >= 960) ?? variants.at(-1);
---
<img {...attributes} src={fallback?.src ?? src} alt={alt}
  srcset={variants.length ? variants.map((v, i) => `${v.src} ${widths[i]}w`).join(', ') : undefined}
  sizes={variants.length ? sizes : undefined}
  width={source?.width ?? attributes.width} height={source?.height ?? attributes.height}
  loading={loading} decoding="async" data-fit={fit} />
