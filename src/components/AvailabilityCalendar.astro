---
import { availability } from '../content/availability';
import { getDateKeyInTimeZone } from '../utils/availabilityDates';
import { nextAvailableDays, isPastMonth } from '../utils/availabilityWindow';
import AvailabilityMonth from './AvailabilityMonth.astro';
interface Props { locale?: 'pl' | 'en'; }
const { locale = 'pl' } = Astro.props;
const en = locale === 'en';
const today = getDateKeyInTimeZone(new Date());
const key = (month: number) => `${availability.year}-${String(month).padStart(2,'0')}`;
const future = availability.months.filter(month => !isPastMonth(key(month), today));
const past = availability.months.filter(month => isPastMonth(key(month), today));
// Derive from every displayed day, including the default, so summary and grids
// cannot diverge if the availability data format is edited later.
const availableDays = availability.months.flatMap(month => Array.from({length:new Date(Date.UTC(availability.year,month,0)).getUTCDate()},(_,i) => `${key(month)}-${String(i+1).padStart(2,'0')}`)).filter(day => (availability.days[day] ?? availability.defaultStatus) === 'available');
const upcoming = nextAvailableDays(availableDays, today);
const format = (day: string) => new Intl.DateTimeFormat(en ? 'en-GB' : 'pl-PL', { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' }).format(new Date(day+'T12:00:00Z'));
const none = en ? 'No upcoming full days are listed. Email me to discuss a date.' : 'Brak kolejnych pełnych dni w kalendarzu. Napisz, aby ustalić termin.';
---
<div class="kc-calendar" data-locale={locale} data-available-days={JSON.stringify(availableDays)}>
  <div class="kc-info-box kc-calendar-summary">
    <p class="kc-eyebrow">{en ? 'Next full days' : 'Najbliższe pełne dni'}</p>
    <p data-next-dates>{upcoming.length ? upcoming.map(format).join(' · ') : none}</p>
    <small>{en ? 'Indicative availability. Every date requires personal confirmation.' : 'Dostępność orientacyjna. Każdy termin wymaga osobistego potwierdzenia.'}</small>
  </div>
  <div class="kc-calendar-legend" aria-label={en ? 'Legend' : 'Legenda'}>
    <span><i class="available" />{en ? 'Available' : 'Wolny'}</span>
    <span><i class="partially-available" />{en ? 'Partially available' : 'Częściowo dostępny'}</span>
    <span><i class="unavailable" />{en ? 'Busy' : 'Zajęty'}</span>
  </div>
  <div class="kc-months" data-current-months>{future.map(month => <AvailabilityMonth month={month} locale={locale} today={today} />)}</div>
  <details class="kc-past-months" hidden={!past.length}>
    <summary>{en ? 'Earlier months' : 'Wcześniejsze miesiące'}</summary>
    <div class="kc-months" data-past-months>{past.map(month => <AvailabilityMonth month={month} locale={locale} today={today} />)}</div>
  </details>
</div>
<style is:global>
.kc-calendar-summary p[data-next-dates] { font-size:clamp(21px,3vw,28px); line-height:1.5; margin:10px 0; }
.kc-calendar-summary small { color:var(--kc-muted); }
.kc-calendar-legend { display:flex; gap:16px; flex-wrap:wrap; margin:28px 0; font-size:13px; }
.kc-calendar-legend span { display:flex; gap:7px; align-items:center; }
.kc-calendar-legend i { width:12px; height:12px; border-radius:50%; border:1px solid #627165; }
.kc-months { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24px; }
.kc-utility .kc-month { margin:0; padding:24px; background:var(--kc-card); border:1px solid var(--kc-rule-14); border-radius:18px; }
.kc-month h2 { margin:0 0 20px; text-transform:capitalize; }
.kc-weekdays,.kc-days { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:5px; }
.kc-weekdays { margin-bottom:8px; font:11px var(--kc-mono); color:var(--kc-muted); text-align:center; }
.kc-day { border-radius:8px; min-width:0; min-height:50px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; font-size:15px; color:#173027; }
.kc-day small { font-size:8px; }
.kc-calendar .available { background:#ccefdc; }
.kc-calendar .partially-available { background:#fff0b8; }
.kc-calendar .unavailable { background:#f1ddd9; }
.kc-calendar .past { background:var(--kc-tint); color:var(--kc-muted); }
.kc-past-months { margin-top:32px; }
.kc-past-months summary { cursor:pointer; padding:16px 0; color:var(--kc-muted); }
.kc-day[aria-current='date'] { outline:2px solid var(--kc-green); outline-offset:2px; }
@media(max-width:800px) { .kc-months { grid-template-columns:1fr; } }
@media(max-width:420px) { .kc-utility .kc-month { padding:16px 12px; } .kc-day small { display:none; } .kc-days { gap:4px; } .kc-day { min-height:36px; } }
</style>
<script>
import { getDateKeyInTimeZone } from '../utils/availabilityDates';
import { isPastMonth, nextAvailableDays } from '../utils/availabilityWindow';
const calendar = document.querySelector<HTMLElement>('.kc-calendar');
if(calendar) {
  const en = calendar.dataset.locale === 'en';
  const availableDays: string[] = JSON.parse(calendar.dataset.availableDays ?? '[]');
  const labels: Record<string,string> = en ? {available:'Available','partially-available':'Partial',unavailable:'Busy',past:'Past'} : {available:'Wolny','partially-available':'Częściowo',unavailable:'Zajęty',past:'Miniony'};
  const current = calendar.querySelector('[data-current-months]')!;
  const previous = calendar.querySelector('[data-past-months]')!;
  const format = new Intl.DateTimeFormat(en ? 'en-GB' : 'pl-PL',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'});
  let lastDate = '';
  function update() {
    const today = getDateKeyInTimeZone(new Date());
    if(today === lastDate) return;
    lastDate = today;
    [...calendar!.querySelectorAll<HTMLElement>('[data-month]')].sort((a,b) => a.dataset.month!.localeCompare(b.dataset.month!)).forEach(month => {
      (isPastMonth(month.dataset.month!,today) ? previous : current).append(month);
    });
    calendar!.querySelector<HTMLDetailsElement>('.kc-past-months')!.hidden = !previous.children.length;
    calendar!.querySelectorAll<HTMLElement>('[data-date]').forEach(day => {
      const status = day.dataset.date! < today ? 'past' : day.dataset.status!;
      day.className = 'kc-day ' + status;
      day.setAttribute('aria-label', `${day.dataset.label}: ${labels[status]}`);
      day.title = `${day.dataset.label}: ${labels[status]}`;
      day.querySelector('small')!.textContent = labels[status];
      if(day.dataset.date === today) day.setAttribute('aria-current','date'); else day.removeAttribute('aria-current');
    });
    const dates = nextAvailableDays(availableDays,today);
    calendar!.querySelector('[data-next-dates]')!.textContent = dates.length ? dates.map(day => format.format(new Date(day+'T12:00:00Z'))).join(' · ') : en ? 'No upcoming full days are listed. Email me to discuss a date.' : 'Brak kolejnych pełnych dni w kalendarzu. Napisz, aby ustalić termin.';
  }
  update();
  window.setInterval(update,60_000);
  document.addEventListener('visibilitychange',() => { if(document.visibilityState === 'visible') update(); });
}
</script>
