---
interface Props { lang?: 'pl' | 'en'; }
const { lang = 'pl' } = Astro.props;
const en = lang === 'en';
---
<dialog class="kc-consent-panel" id="kc-consent" aria-labelledby="kc-consent-title" data-lang={lang}>
  <div class="kc-consent-heading">
    <h2 id="kc-consent-title">{en ? 'Your cookie choices' : 'Twoje ustawienia cookies'}</h2>
    <button type="button" data-cookie-close aria-label={en ? 'Close cookie settings' : 'Zamknij ustawienia cookies'}>×</button>
  </div>
  <p>{en ? 'With your permission, Google Analytics helps us understand visits and improve the website. Advertising consent stays off. Your cookie choice and appearance preference are stored to remember your settings.' : 'Za Twoją zgodą Google Analytics pomaga nam analizować odwiedziny i ulepszać stronę. Zgoda na reklamę pozostaje wyłączona. Zapisujemy Twój wybór cookies i preferencję wyglądu, aby pamiętać ustawienia.'}</p>
  <p class="kc-consent-status" aria-live="polite"></p>
  <div class="kc-consent-actions">
    <button type="button" data-cookie-choice="deny">{en ? 'Only necessary' : 'Tylko niezbędne'}</button>
    <button type="button" data-cookie-choice="accept">{en ? 'Allow analytics' : 'Zezwól na analitykę'}</button>
    <a href={en ? '/en/privacy-policy/' : '/privacy-policy/'}>{en ? 'Privacy policy' : 'Polityka prywatności'} →</a>
  </div>
  <p class="kc-consent-note">{en ? 'Change or withdraw consent anytime using Cookie settings in the footer.' : 'Zmień lub wycofaj zgodę w dowolnym momencie przez Ustawienia cookies w stopce.'}</p>
</dialog>
<style is:global>
.kc-consent-panel { box-sizing:border-box; position:fixed; inset:auto 16px 16px; margin:0 auto; width:min(760px, calc(100% - 32px)); max-height:85dvh; overflow:auto; padding:24px; border:1px solid #aeb8af; border-radius:18px; background:#faf9f6; color:#12201b; font:15px/1.55 'Helvetica Neue',Arial,sans-serif; box-shadow:0 12px 60px #0003; z-index:10000; text-align:left; }
.kc-consent-panel:not([open]) { display:none; }
.kc-consent-panel::backdrop { background:#071b1477; }
.kc-consent-heading { display:flex; align-items:center; justify-content:space-between; gap:16px; }
.kc-consent-heading h2 { margin:0; font-size:22px; color:inherit; }
.kc-consent-heading button { border:0; background:none; color:inherit; font-size:28px; cursor:pointer; width:44px; height:44px; flex:none; }
.kc-consent-panel p { margin:10px 0; font:inherit; color:inherit; }
.kc-consent-actions { display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-top:16px; }
.kc-consent-actions button { background:#0a4731; color:#fff; border:1px solid #0a4731; border-radius:24px; padding:11px 18px; min-height:44px; font:600 14px/1.3 'Helvetica Neue',Arial,sans-serif; cursor:pointer; }
.kc-consent-actions a { color:inherit; text-decoration:underline; }
.kc-consent-panel .kc-consent-note { font-size:12px; margin-top:14px; }
:root[data-theme='dark'] .kc-consent-panel { background:#111714; color:#f7f0e5; border-color:#c5a67066; }
:root[data-theme='dark'] .kc-consent-actions button { background:#c5a670; border-color:#c5a670; color:#0b0f0d; }
@media(max-width:480px) { .kc-consent-panel { padding:18px; } .kc-consent-actions button { flex:1; } }
</style>
<script is:inline>
(function () {
  var panel = document.getElementById('kc-consent');
  var en = panel.dataset.lang === 'en';
  var opener;
  function status() {
    var choice = window.kcGetConsent();
    panel.querySelector('.kc-consent-status').textContent = choice === 'analytics-v2'
      ? (en ? 'Current choice: analytics allowed.' : 'Obecny wybór: analityka dozwolona.')
      : choice === 'denied' ? (en ? 'Current choice: only necessary.' : 'Obecny wybór: tylko niezbędne.') : '';
  }
  function open() {
    opener = document.activeElement;
    if (panel.open) panel.close();
    status();
    panel.showModal();
  }
  function close() { panel.close(); if(opener) opener.focus(); }
  document.querySelectorAll('[data-cookie-settings]').forEach(function (button) { button.addEventListener('click', open); });
  panel.querySelector('[data-cookie-close]').addEventListener('click', close);
  panel.querySelectorAll('[data-cookie-choice]').forEach(function (button) {
    button.addEventListener('click', function () { window.kcSetConsent(button.dataset.cookieChoice === 'accept'); close(); });
  });
  window.addEventListener('kc-consent-changed', function () { status(); panel.close(); });
  status();
  if (!window.kcGetConsent()) panel.show();
})();
</script>
