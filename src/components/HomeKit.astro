<script>
  import { getDateKeyInTimeZone } from '../utils/availabilityDates';
  import { formatReadout, formatSpoken, pickNextFreeDate } from '../utils/nextFreeDate';

  // ---------- copy keys ----------
  // A key stays hidden unless the browser can actually copy, so nobody is
  // shown a control that does nothing.

  const copyText = async (text: string) => {
    if (navigator.clipboard?.writeText) {
      await navigator.clipboard.writeText(text);
      return;
    }
    // Older browsers, and pages not served over HTTPS.
    const field = document.createElement('textarea');
    field.value = text;
    field.setAttribute('readonly', '');
    field.style.position = 'fixed';
    field.style.opacity = '0';
    document.body.append(field);
    field.select();
    const copied = document.execCommand('copy');
    field.remove();
    if (!copied) throw new Error('Copy was refused');
  };

  const canCopy =
    typeof navigator.clipboard?.writeText === 'function' ||
    (typeof document.queryCommandSupported === 'function' && document.queryCommandSupported('copy'));

  if (canCopy) {
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((key) => {
      const label = key.querySelector<HTMLElement>('[data-copy-label]');
      const status = key.nextElementSibling?.matches('[data-copy-status]')
        ? (key.nextElementSibling as HTMLElement)
        : null;
      const idle = label?.textContent ?? '';
      const done = key.dataset.copyDone ?? idle;
      let timer = 0;

      key.hidden = false;
      key.addEventListener('click', async () => {
        try {
          await copyText(key.dataset.copy ?? '');
        } catch {
          // The address is still printed on the button beside this key.
          return;
        }
        key.dataset.state = 'done';
        if (label) label.textContent = done;
        if (status) status.textContent = done;
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          delete key.dataset.state;
          if (label) label.textContent = idle;
          if (status) status.textContent = '';
        }, 1800);
      });
    });
  }

  // ---------- next free date ----------
  // The build prints a value; this keeps it true after midnight in Warsaw.

  const readouts = document.querySelectorAll<HTMLAnchorElement>('[data-next-date]');

  const refreshReadouts = () => {
    const today = getDateKeyInTimeZone(new Date());
    readouts.forEach((readout) => {
      const language = readout.dataset.lang === 'en' ? 'en' : 'pl';
      const days = (readout.dataset.days ?? '').split(',').filter(Boolean);
      const next = pickNextFreeDate(days, today, readout.dataset.updated ?? today);
      const display = readout.querySelector<HTMLTimeElement>('[data-lcd]');

      readout.hidden = !next;
      if (!next || !display) return;
      display.dateTime = next;
      display.textContent = formatReadout(next, language);
      readout.setAttribute('aria-label', `${readout.dataset.label}: ${formatSpoken(next, language)}`);
    });
  };

  if (readouts.length) {
    refreshReadouts();
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') refreshReadouts();
    });
  }

  // ---------- human / robot switch ----------
  // Lasts for this page view only. Nothing is stored, so a reload is always
  // the normal page.

  const viewSwitch = document.querySelector<HTMLButtonElement>('[data-view-switch]');
  const viewControl = document.querySelector<HTMLElement>('[data-view-control]');

  const setRobotView = (on: boolean) => {
    if (on) document.documentElement.dataset.view = 'robot';
    else delete document.documentElement.dataset.view;
    viewSwitch?.setAttribute('aria-checked', String(on));
    // Instant on purpose: the page has just changed shape under the visitor.
    if (on) window.scrollTo({ top: 0, behavior: 'instant' as ScrollBehavior });
  };

  if (viewSwitch && viewControl) {
    viewControl.hidden = false;
    viewSwitch.addEventListener('click', () => {
      setRobotView(viewSwitch.getAttribute('aria-checked') !== 'true');
    });
    document.querySelector('[data-view-exit]')?.addEventListener('click', () => {
      setRobotView(false);
      viewSwitch.focus();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && document.documentElement.dataset.view === 'robot') {
        setRobotView(false);
      }
    });
  }
</script>
