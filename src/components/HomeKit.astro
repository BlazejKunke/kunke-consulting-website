---
// Styles and behaviour for the small "hardware" details on the two homepages:
// the copy key, the next free date readout, the assistant keys, the rating plate, the human / robot switch and the
// printed offer sheet. docs/home-kit.md explains each one.
//
// Kept in one shared component so the Polish and English homepages cannot
// drift apart: both render <HomeKit /> once and get identical rules. It
// renders no markup of its own.
//
// Everything leans on the --kc-* tokens the homepages declare, and restates a
// dark rule wherever the light theme would have used --kc-green as an accent,
// because in the dark theme that token is a near black.
---
<style is:global>
  :root {
    /* The one orange knob. Used for a lamp and a switch, never for text. */
    --kc-signal: #e2731b;
    /* The same idea dark enough to read as small type on the page ground. */
    --kc-signal-ink: #a8500a;
    --kc-lcd-bg: #c9d0c1;
    --kc-lcd-ink: #17211b;
  }

  :root[data-theme='dark'] {
    --kc-signal: #f0913a;
    --kc-signal-ink: var(--kc-brass);
    /* A negative display, like the black faced watch. */
    --kc-lcd-bg: #070a08;
    --kc-lcd-ink: #d9e0d2;
  }

  .kc-sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ---------- the key ---------- */

  .kc-key {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    padding: 0 15px;
    border: 1px solid var(--kc-rule-25);
    border-radius: 10px;
    background: var(--kc-card);
    color: var(--kc-ink);
    font: 500 12px/1 var(--kc-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    /* The hard shadow is the key's travel: pressing it uses it up. */
    box-shadow: 0 2px 0 var(--kc-rule-25);
    transition: transform 90ms ease, box-shadow 90ms ease, border-color 200ms ease;
  }

  .kc-key[hidden] {
    display: none !important;
  }

  .kc-key:hover {
    border-color: var(--kc-rule-42);
    color: var(--kc-ink);
    text-decoration: none;
  }

  .kc-key:active {
    transform: translateY(2px);
    box-shadow: 0 0 0 var(--kc-rule-25);
  }

  :root[data-theme='dark'] .kc-key,
  :root[data-theme='dark'] .kc-key:hover {
    color: var(--kc-ink);
  }

  :root[data-theme='dark'] .kc-key:hover {
    border-color: var(--kc-brass-soft);
  }

  .kc-key-led {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--kc-rule-25);
    transition: background-color 150ms ease, box-shadow 150ms ease;
  }

  .kc-key[data-state='done'] .kc-key-led {
    background: var(--kc-signal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--kc-signal) 24%, transparent);
  }

  /* ---------- next free date ---------- */

  .kc-lcd {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 12px;
    min-height: 44px;
    font: 500 12px/1.3 var(--kc-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--kc-muted);
    text-decoration: none;
  }

  .kc-lcd[hidden] {
    display: none;
  }

  .kc-lcd:hover {
    color: var(--kc-ink);
    text-decoration: none;
  }

  :root[data-theme='dark'] .kc-lcd {
    color: var(--kc-muted);
  }

  :root[data-theme='dark'] .kc-lcd:hover {
    color: var(--kc-ink);
  }

  .kc-lcd-window {
    padding: 7px 11px 6px;
    border: 1px solid rgba(18, 32, 27, 0.28);
    border-radius: 5px;
    background: var(--kc-lcd-bg);
    color: var(--kc-lcd-ink);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.22);
  }

  :root[data-theme='dark'] .kc-lcd-window {
    border-color: var(--kc-brass-soft);
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.8);
  }

  .kc-hero-status {
    margin-top: 22px;
  }

  .kc-contact-cta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .kc-contact-status {
    margin-top: 22px;
  }

  /* ---------- ask your assistant ---------- */

  .kc-ask {
    margin-top: 36px;
  }

  .kc-ask-label {
    margin: 0 0 14px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--kc-body);
  }

  .kc-ask-keys {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .kc-ask-note {
    margin: 14px 0 0;
    max-width: 44em;
    font: 400 12px/1.6 var(--kc-mono);
    color: var(--kc-muted);
  }

  /* ---------- rating plate ---------- */

  .kc-plate-wrap {
    max-width: var(--kc-wrap);
    margin: 0 auto;
    padding: 32px 32px 0;
  }

  .kc-plate {
    --kc-rivet: var(--kc-rule-25);
    display: flex;
    align-items: center;
    gap: 20px 32px;
    flex-wrap: wrap;
    padding: 22px 30px;
    border: 1px solid var(--kc-rule-20);
    border-radius: 14px;
    background:
      radial-gradient(circle at 11px 11px, var(--kc-rivet) 2px, transparent 2.6px),
      radial-gradient(circle at calc(100% - 11px) 11px, var(--kc-rivet) 2px, transparent 2.6px),
      radial-gradient(circle at 11px calc(100% - 11px), var(--kc-rivet) 2px, transparent 2.6px),
      radial-gradient(circle at calc(100% - 11px) calc(100% - 11px), var(--kc-rivet) 2px, transparent 2.6px),
      var(--kc-card);
  }

  .kc-plate-mark {
    margin: 0;
    font: 600 22px/1 var(--kc-mono);
    letter-spacing: -0.04em;
    color: var(--kc-green);
  }

  :root[data-theme='dark'] .kc-plate-mark {
    color: var(--kc-brass);
  }

  .kc-plate-grid {
    flex: 1 1 420px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    margin: 0;
  }

  .kc-plate-grid dt,
  .kc-plate-control-label {
    margin: 0;
    font: 500 11px/1.4 var(--kc-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--kc-muted);
  }

  .kc-plate-grid dd {
    margin: 3px 0 0;
    font: 500 13px/1.4 var(--kc-mono);
    letter-spacing: 0;
    color: var(--kc-ink);
  }

  .kc-plate-control[hidden] {
    display: none;
  }

  .kc-view-switch {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    margin: -8px 0 -12px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    font: 500 12px/1 var(--kc-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--kc-muted);
  }

  .kc-view-track {
    position: relative;
    flex: none;
    width: 46px;
    height: 24px;
    border: 1px solid var(--kc-rule-25);
    border-radius: 999px;
    background: var(--kc-rule-10);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.16);
  }

  .kc-view-knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--kc-signal);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
    transition: transform 160ms ease;
  }

  .kc-view-switch[aria-checked='true'] .kc-view-knob {
    transform: translateX(22px);
  }

  .kc-view-switch[aria-checked='false'] .kc-view-option:first-child,
  .kc-view-switch[aria-checked='true'] .kc-view-option:last-child {
    color: var(--kc-ink);
  }

  /* ---------- robot view ---------- */

  .kc-robot-note {
    display: none;
  }

  :root[data-view='robot'] .kc-robot-note {
    display: block;
    max-width: var(--kc-wrap);
    margin: 0 auto;
    padding: 28px var(--kc-gut) 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--kc-body);
  }

  :root[data-view='robot'] .kc-robot-note p {
    margin: 0 0 8px;
    max-width: 62em;
  }

  :root[data-view='robot'] .kc-robot-note .kc-robot-title {
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em !important;
    color: var(--kc-ink);
  }

  :root[data-view='robot'] .kc-robot-note .kc-robot-title::before {
    content: '> ';
    color: var(--kc-signal-ink);
  }

  :root[data-view='robot'] .kc-robot-note .kc-key {
    margin-top: 10px;
  }

  /* One typeface, no pictures, no movement. !important throughout: this is
     an override view sitting on top of the whole page stylesheet, in either
     theme. */
  :root[data-view='robot'] body,
  :root[data-view='robot'] body * {
    font-family: var(--kc-mono) !important;
    letter-spacing: 0 !important;
    animation: none !important;
    transition: none !important;
  }

  :root[data-view='robot'] body::after,
  :root[data-view='robot'] :is(
    img,
    picture,
    .kc-polaroid,
    .kc-about-media,
    .kc-team-photo,
    .kc-case-media,
    .kc-lamplight,
    .kc-voices-nav,
    .kc-voice-mark,
    .kc-typed-caret
  ) {
    display: none !important;
  }

  /* The typed headline holds still: show the full sentence the layout
     reserves room for, and hide the copy being typed over it. */
  :root[data-view='robot'] .kc-typed-sizer {
    visibility: visible !important;
  }

  :root[data-view='robot'] .kc-typed > span:not(.kc-typed-sizer) {
    display: none !important;
  }

  :root[data-view='robot'] .kc-hero h1 {
    font-size: clamp(21px, 3vw, 30px) !important;
    line-height: 1.35 !important;
    font-weight: 600 !important;
  }

  :root[data-view='robot'] :is(h2, .kc-fact-big) {
    font-size: 20px !important;
    line-height: 1.4 !important;
    font-weight: 600 !important;
  }

  :root[data-view='robot'] :is(h3, .kc-faq-q, .kc-voice-text, .kc-lead) {
    font-size: 16px !important;
    line-height: 1.6 !important;
  }

  :root[data-view='robot'] :is(h3, .kc-faq-q) {
    font-weight: 600 !important;
  }

  /* Headings and lists marked the way Markdown marks them. */
  :root[data-view='robot'] .kc-typed-sizer::before {
    content: '# ';
  }

  :root[data-view='robot'] h2::before {
    content: '## ';
  }

  :root[data-view='robot'] .kc-card h3::before,
  :root[data-view='robot'] .kc-faq-q > span:first-child::before {
    content: '### ';
  }

  :root[data-view='robot'] :is(.kc-typed-sizer, h2, .kc-card h3, .kc-faq-q > span:first-child)::before {
    color: var(--kc-muted);
    font-weight: 400;
  }

  :root[data-view='robot'] .kc-card-items li {
    padding-left: 0 !important;
    border-left: 0 !important;
  }

  :root[data-view='robot'] .kc-card-items li::before {
    content: '- ';
    color: var(--kc-muted);
  }

  /* Surfaces go flat, and the green panel turns back into plain text. */
  :root[data-view='robot'] :is(
    .kc-card,
    .kc-voice,
    .kc-case-panel,
    .kc-plate,
    .kc-btn,
    .kc-btn-light,
    .kc-btn-ghost,
    .kc-key,
    .kc-lcd-window
  ) {
    border-radius: 0 !important;
    box-shadow: none !important;
    transform: none !important;
  }

  :root[data-view='robot'] :is(.kc-facts, .kc-footer, .kc-header) {
    background: var(--kc-bg) !important;
  }

  :root[data-view='robot'] .kc-case-panel {
    display: block !important;
    background: transparent !important;
    border: 1px solid var(--kc-rule-25) !important;
  }

  :root[data-view='robot'] .kc-case-panel,
  :root[data-view='robot'] .kc-case-panel :is(h2, p) {
    color: var(--kc-ink) !important;
  }

  :root[data-view='robot'] :is(.kc-btn, .kc-btn-light, .kc-btn-ghost) {
    background: transparent !important;
    color: var(--kc-ink) !important;
    border: 1px solid var(--kc-rule-42) !important;
  }

  /* ---------- small screens ---------- */

  @media (max-width: 600px) {
    .kc-hero-cta .kc-key,
    .kc-contact-cta .kc-key {
      display: flex;
      justify-content: center;
      width: 100%;
      min-height: 48px;
      margin-top: 10px;
    }

    .kc-contact-cta {
      display: block;
    }

    .kc-hero-status,
    .kc-contact-status {
      margin-top: 14px;
    }

    /* Label, window and arrow have to share one line on a phone. */
    .kc-lcd {
      flex-wrap: nowrap;
      gap: 10px;
      letter-spacing: 0.04em;
    }

    .kc-lcd-more-word {
      display: none;
    }

    .kc-plate-wrap {
      padding: 24px 20px 0;
    }

    .kc-plate {
      padding: 22px 22px 20px;
    }

    .kc-ask-keys .kc-key {
      flex: 1 1 auto;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kc-key,
    .kc-key-led,
    .kc-view-knob {
      transition: none;
    }

    .kc-key:active {
      transform: none;
    }
  }

  /* ---------- the printed offer sheet ----------
     Printing the homepage gives a clean document instead of a screenshot of
     a website: page one is the offer with prices and contact details, the
     pages after it are the evidence. Always light, whichever theme is on. */

  @media print {
    @page {
      size: A4;
      margin: 13mm 14mm 14mm;
    }

    :root:root:root {
      --kc-bg: #ffffff;
      --kc-card: #ffffff;
      --kc-band: #ffffff;
      --kc-ink: #12201b;
      --kc-green: #0a4731;
      --kc-body: #2c3a34;
      --kc-muted: #52625a;
      --kc-brass: #0a4731;
      --kc-brass-soft: rgba(10, 71, 49, 0.3);
      --kc-signal-ink: #52625a;
      --kc-serif: var(--kc-sans);
      --kc-rule-08: rgba(10, 71, 49, 0.2);
      --kc-rule-10: rgba(10, 71, 49, 0.2);
      --kc-rule-12: rgba(10, 71, 49, 0.25);
      --kc-rule-14: rgba(10, 71, 49, 0.25);
      --kc-rule-16: rgba(10, 71, 49, 0.25);
      --kc-rule-18: rgba(10, 71, 49, 0.3);
      --kc-rule-20: rgba(10, 71, 49, 0.3);
      --kc-rule-24: rgba(10, 71, 49, 0.3);
      --kc-rule-25: rgba(10, 71, 49, 0.3);
      --kc-rule-42: rgba(10, 71, 49, 0.42);
      --kc-gut: 0px;
      color-scheme: light;
    }

    html,
    body {
      background: #ffffff !important;
    }

    body::after,
    .kc-header,
    .kc-skip,
    .kc-lamplight,
    .cookie-consent,
    .kc-robot-note,
    .kc-key,
    .kc-lcd,
    .kc-ask,
    .kc-plate-control,
    .kc-hero-cta,
    .kc-hero-status,
    .kc-contact-status,
    .kc-polaroid,
    .kc-voices-nav,
    .kc-voice-mark,
    .kc-case-media,
    .kc-case-cta,
    .kc-about-media,
    .kc-team-photo,
    .kc-card-foot a,
    .kc-faq-sign,
    .kc-footer-inner,
    .kc-typed-caret,
    .kc-typed > span:not(.kc-typed-sizer) {
      display: none !important;
    }

    .kc-typed-sizer {
      visibility: visible !important;
    }

    * {
      animation: none !important;
      transition: none !important;
      box-shadow: none !important;
      filter: none !important;
    }

    a {
      color: inherit !important;
      text-decoration: none !important;
    }

    /* The letterhead: the contact details that would otherwise only be on
       the last page. */
    main::before {
      content: '^Kunke Consulting   ·   kunkeconsulting.pl   ·   info@kunkeconsulting.pl   ·   +48 722 156 925';
      display: block;
      padding-bottom: 9px;
      border-bottom: 1px solid #0a4731;
      font: 600 10.5px/1.4 var(--kc-mono);
      letter-spacing: 0.04em;
      color: #0a4731;
    }

    .kc-hero,
    .kc-section,
    .kc-facts,
    .kc-case,
    .kc-voices,
    .kc-contact {
      max-width: none !important;
      margin: 0 !important;
      padding: 22px 0 0 !important;
      background: none !important;
      border: 0 !important;
    }

    .kc-hero {
      display: block !important;
    }

    .kc-hero h1 {
      max-width: none !important;
      font-size: 30px !important;
      line-height: 1.12 !important;
      font-family: var(--kc-sans) !important;
      font-weight: 500 !important;
    }

    .kc-typed-var {
      display: inline !important;
    }

    .kc-typed-var::before {
      content: ' ';
    }

    .kc-lead {
      max-width: 46em !important;
      margin: 12px 0 0 !important;
      font-size: 13px !important;
      line-height: 1.5 !important;
    }

    .kc-hero .kc-eyebrow {
      margin-bottom: 12px !important;
    }

    .kc-hero-side {
      display: block !important;
      margin: 12px 0 0 !important;
      padding: 0 !important;
    }

    .kc-hero-notes {
      display: flex !important;
      flex-direction: row !important;
      gap: 24px !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .kc-note {
      font-size: 10.5px !important;
      line-height: 1.5 !important;
      padding-left: 10px !important;
    }

    .kc-eyebrow,
    .kc-card-tag {
      font-size: 9.5px !important;
    }

    .kc-facts-grid {
      display: grid !important;
      grid-template-columns: repeat(4, 1fr) !important;
      gap: 16px !important;
      max-width: none !important;
      padding: 12px 0 !important;
      border-block: 1px solid var(--kc-rule-20) !important;
    }

    .kc-fact-big {
      font-size: 17px !important;
      font-weight: 500 !important;
      margin: 0 0 3px !important;
    }

    .kc-fact-small {
      font-size: 10.5px !important;
      line-height: 1.45 !important;
      margin: 0 !important;
    }

    .kc-split,
    .kc-offer-head {
      display: block !important;
      margin-bottom: 0 !important;
    }

    .kc-h2,
    .kc-team-h2,
    .kc-case-body h2,
    .kc-about h2,
    .kc-contact h2 {
      max-width: none !important;
      margin: 5px 0 12px !important;
      font-size: 18px !important;
      line-height: 1.25 !important;
      font-weight: 500 !important;
    }

    .kc-steps,
    .kc-cards {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      gap: 12px !important;
      margin: 0 !important;
    }

    .kc-step {
      padding: 0 !important;
      border: 0 !important;
    }

    .kc-step-label {
      font-size: 10px !important;
      margin: 0 0 4px !important;
    }

    .kc-step-text,
    .kc-card-blurb,
    .kc-card-items li {
      font-size: 11px !important;
      line-height: 1.45 !important;
      margin: 0 !important;
    }

    .kc-card {
      gap: 10px !important;
      padding: 14px 14px 12px !important;
      border-radius: 8px !important;
      transform: none !important;
      break-inside: avoid;
    }

    .kc-card h3 {
      margin: 0 0 4px !important;
      font-size: 16px !important;
    }

    .kc-card-tag {
      margin: 0 0 6px !important;
    }

    .kc-card-items {
      gap: 4px !important;
    }

    .kc-card-items li {
      padding-left: 9px !important;
    }

    .kc-card-foot {
      padding-top: 9px !important;
    }

    .kc-price {
      font-size: 13px !important;
    }

    /* Page two onward: what clients say, the case study, the people, the
       questions. */
    .kc-voices {
      break-before: page;
    }

    .kc-voices-head {
      display: block !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .kc-voices-rail {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      gap: 12px !important;
      overflow: visible !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    .kc-voice {
      min-height: 0 !important;
      margin: 0 !important;
      padding: 12px 14px !important;
      border-radius: 8px !important;
      break-inside: avoid;
    }

    .kc-voice-text {
      margin: 0 0 8px !important;
      font-size: 12px !important;
      line-height: 1.45 !important;
      font-family: var(--kc-sans) !important;
    }

    .kc-voice-who,
    .kc-voice-role {
      font-size: 10px !important;
    }

    .kc-case-panel {
      display: block !important;
      background: none !important;
      border: 1px solid var(--kc-rule-25) !important;
      border-radius: 8px !important;
      color: var(--kc-ink) !important;
      break-inside: avoid;
    }

    .kc-case-body {
      padding: 14px !important;
    }

    .kc-case-body .kc-eyebrow {
      margin-bottom: 4px !important;
      color: var(--kc-muted) !important;
    }

    .kc-case-body p {
      max-width: none !important;
      margin: 0 !important;
      font-size: 11.5px !important;
      line-height: 1.5 !important;
      color: var(--kc-body) !important;
    }

    .kc-case-body::after {
      content: 'kunkeconsulting.pl/Raport-AI-w-PragmatIQ.pdf';
      display: block;
      margin-top: 8px;
      font: 500 10px/1.4 var(--kc-mono);
      color: var(--kc-green);
