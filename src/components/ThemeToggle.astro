---
interface Props { lang?: 'pl' | 'en'; }
const { lang = 'pl' } = Astro.props;
---
<button type="button" class="kc-theme-toggle" data-theme-toggle>
  <svg class="kc-theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <path d="M20.35 16.04A9 9 0 1 1 7.96 3.65a9 9 0 0 0 12.39 12.39Z" />
  </svg>
  <svg class="kc-theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
  </svg>
  <span class="kc-theme-label kc-theme-label-dark">{lang === 'en' ? 'Switch to dark mode' : 'Włącz tryb ciemny'}</span>
  <span class="kc-theme-label kc-theme-label-light">{lang === 'en' ? 'Switch to light mode' : 'Włącz tryb jasny'}</span>
</button>
<style is:global>
  .kc-theme-toggle {
    width: 44px;
    height: 44px;
    flex: none;
    padding: 0;
    border: 0;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: transparent;
    color: var(--kc-body, #3a4a43);
    cursor: pointer;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .kc-theme-toggle svg { width: 22px; height: 22px; }
  .kc-theme-toggle:hover { background: var(--kc-rule-08); color: var(--kc-ink); }
  .kc-theme-toggle:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  :root[data-theme='dark'] .kc-theme-toggle { color: var(--kc-brass); }

  .kc-theme-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Both the icon and accessible name describe the next action from first paint. */
  :root[data-theme='dark'] :is(.kc-theme-moon, .kc-theme-label-dark),
  :root:not([data-theme='dark']) :is(.kc-theme-sun, .kc-theme-label-light) { display: none; }

  @media (prefers-reduced-motion: reduce) { .kc-theme-toggle { transition: none; } }
</style>
<script>
  const toggle = document.querySelector('[data-theme-toggle]');
  const themeMeta = document.querySelector('meta[name="theme-color"]');

  toggle?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    themeMeta?.setAttribute('content', next === 'dark' ? '#0b0f0d' : '#faf9f6');
    try {
      localStorage.setItem('kc-theme', next);
    } catch {
      // The current page still switches when browser storage is unavailable.
    }
  });
</script>
