---
interface Props { lang?: 'pl' | 'en'; }
const { lang = 'pl' } = Astro.props;
---
<button class="kc-cookie-settings" type="button" data-cookie-settings>{lang === 'en' ? 'Cookie settings' : 'Ustawienia cookies'}</button>
<style is:global>
.kc-cookie-settings { font:inherit; letter-spacing:inherit; color:inherit; border:0; padding:8px 0; background:none; cursor:pointer; text-decoration:none; }
.kc-cookie-settings:hover { color:var(--kc-ink, #12201b); }
.kc-cookie-settings:focus-visible { outline:2px solid currentColor; outline-offset:3px; border-radius:4px; }
/* Align button text with link text while retaining its padded hit area. */
.kc-footer-links { align-items: baseline; }
</style>
