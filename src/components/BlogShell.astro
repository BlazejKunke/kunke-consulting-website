---
// Shared shell for the blog — index pages and the article template.
//
// Imported from the Claude Design project "Blog ^Kunke Consulting.dc.html" and
// harmonised with the redesigned homepage: same palette, type stack, sticky
// header and one-line footer, so /blog/ and / read as one site. Like the
// homepage this page family deliberately avoids BaseLayout and global.css,
// which would override the type scale and centre the headings.
//
// The design's dark green PL/EN utility strip and four-column footer were
// dropped in favour of the homepage chrome (Blaze's call, July 2026).

export type BlogLang = 'pl' | 'en';

interface Props {
  lang: BlogLang;
  title: string;
  description: string;
  canonicalUrl: string;
  ogImage: string;
  ogType?: 'website' | 'article';
}

const { lang, title, description, canonicalUrl, ogImage, ogType = 'website' } = Astro.props;

const isEnglish = lang === 'en';
const blogIndexUrl = isEnglish ? '/en/blog/' : '/blog/';
const otherBlogUrl = isEnglish ? '/blog/' : '/en/blog/';

const nav = isEnglish
  ? [
      { href: '/en/#offer', label: 'Offer' },
      { href: '/en/#implementation', label: 'Implementation' },
      { href: '/en/#team', label: 'Team' },
      { href: '/en/blog/', label: 'Blog', current: true }
    ]
  : [
      { href: '/#oferta', label: 'Oferta' },
      { href: '/#wdrozenie', label: 'Wdrożenie' },
      { href: '/#zespol', label: 'Zespół' },
      { href: '/blog/', label: 'Blog', current: true }
    ];

const copy = isEnglish
  ? {
      skip: 'Skip to content',
      navLabel: 'Main navigation',
      cta: 'Email me',
      switchLabel: 'PL',
      privacy: 'Privacy policy',
      robots: 'For robots'
    }
  : {
      skip: 'Przejdź do treści',
      navLabel: 'Główna nawigacja',
      cta: 'Napisz',
      switchLabel: 'EN',
      privacy: 'Polityka prywatności',
      robots: 'Dla robotów'
    };
---

<!DOCTYPE html>
<html lang={isEnglish ? 'en' : 'pl'}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />

  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content={isEnglish ? 'en_US' : 'pl_PL'} />
  <meta property="og:site_name" content="Kunke Consulting" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/images/Kunke_Favicon.png" />
  <link rel="shortcut icon" href="/favicon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <slot name="head" />

  <style is:global>
    :root {
      --kc-bg: #faf9f6;
      --kc-ink: #12201b;
      --kc-green: #0a4731;
      --kc-green-deep: #073725;
      --kc-body: #3a4a43;
      --kc-muted: #52625a;
      --kc-card: #ffffff;
      --kc-tint: #f3f1ea;
      --kc-rule-08: rgba(10, 71, 49, 0.08);
      --kc-rule-10: rgba(10, 71, 49, 0.1);
      --kc-rule-12: rgba(10, 71, 49, 0.12);
      --kc-rule-14: rgba(10, 71, 49, 0.14);
      --kc-rule-18: rgba(10, 71, 49, 0.18);
      --kc-rule-20: rgba(10, 71, 49, 0.2);
      --kc-rule-25: rgba(10, 71, 49, 0.25);
      --kc-rule-42: rgba(10, 71, 49, 0.42);
      --kc-sans: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      --kc-mono: ui-monospace, 'SF Mono', Menlo, monospace;
      --kc-wrap: 1120px;
      --kc-gut: 32px;
      /* The hatch that stands in for a missing hero image, straight from the
         design's placeholder blocks. */
      --kc-hatch: repeating-linear-gradient(
        135deg,
        rgba(10, 71, 49, 0.1) 0 9px,
        rgba(10, 71, 49, 0) 9px 18px
      );
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      /* Sticky header shouldn't cover anchored headings. */
      scroll-padding-top: 88px;
    }

    body {
      margin: 0;
      background: var(--kc-bg);
      color: var(--kc-ink);
      font-family: var(--kc-sans);
      letter-spacing: -0.01em;
      -webkit-font-smoothing: antialiased;
    }

    a {
      color: var(--kc-green);
      text-decoration: none;
    }

    a:hover {
      color: var(--kc-ink);
      text-decoration: underline;
      text-underline-offset: 3px;
    }

    ::selection {
      background: var(--kc-green);
      color: var(--kc-bg);
    }

    :focus-visible {
      outline: 2px solid var(--kc-green);
      outline-offset: 3px;
      border-radius: 4px;
    }

    img {
      max-width: 100%;
    }

    /* ---------- primitives (shared with the homepage) ---------- */

    .kc-eyebrow {
      font-family: var(--kc-mono);
      font-size: 13px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--kc-muted);
      margin: 0;
    }

    .kc-btn {
      display: inline-block;
      border-radius: 999px;
      background: var(--kc-green);
      color: var(--kc-bg);
      transition: background-color 200ms ease;
    }

    .kc-btn:hover {
      background: var(--kc-ink);
      color: var(--kc-bg);
      text-decoration: none;
    }

    .kc-btn-ghost {
      display: inline-block;
      border-radius: 999px;
      border: 1px solid var(--kc-rule-25);
      color: var(--kc-green);
      transition: background-color 200ms ease, color 200ms ease;
    }

    .kc-btn-ghost:hover {
      background: var(--kc-green);
      color: var(--kc-bg);
      text-decoration: none;
    }

    .kc-skip {
      position: absolute;
      left: -9999px;
      top: 0;
      z-index: 100;
      background: var(--kc-green);
      color: var(--kc-bg);
      padding: 12px 18px;
      border-radius: 0 0 8px 0;
    }

    .kc-skip:focus {
      left: 0;
      color: var(--kc-bg);
    }

    /* ---------- header ---------- */

    .kc-header {
      position: sticky;
      top: 0;
      z-index: 20;
      background: rgba(250, 249, 246, 0.88);
      backdrop-filter: saturate(140%) blur(12px);
      border-bottom: 1px solid var(--kc-rule-10);
    }

    .kc-nav {
      max-width: var(--kc-wrap);
      margin: 0 auto;
      padding: 16px var(--kc-gut);
      display: flex;
      align-items: center;
      gap: 32px;
    }

    .kc-brand {
      font-size: 17px;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--kc-green);
    }

    .kc-nav-links {
      display: flex;
      gap: 26px;
      margin-left: auto;
      font-size: 16px;
    }

    .kc-nav-links a {
      color: var(--kc-body);
    }

    /* Current section, per the design's underlined "Blog" item. */
    .kc-nav-links a[aria-current='page'] {
      color: var(--kc-green);
      font-weight: 600;
      border-bottom: 2px solid var(--kc-green);
      padding-bottom: 2px;
    }

    .kc-nav .kc-btn {
      font-size: 15px;
      padding: 8px 16px;
    }

    /* ---------- footer ---------- */

    .kc-footer {
      border-top: 1px solid var(--kc-rule-10);
      background: rgba(10, 71, 49, 0.02);
    }

    .kc-footer-inner {
      max-width: var(--kc-wrap);
      margin: 0 auto;
      padding: 32px;
      display: flex;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
      font-size: 15px;
      color: var(--kc-muted);
    }

    .kc-footer-inner p {
      margin: 0;
    }

    .kc-footer-links {
      display: flex;
      gap: 20px;
      margin-left: auto;
      flex-wrap: wrap;
    }

    .kc-footer-links a {
      color: var(--kc-muted);
    }

    /* ---------- breadcrumb ---------- */

    .kc-crumbs {
      display: flex;
      align-items: center;
      gap: 10px;
      font-family: var(--kc-mono);
      font-size: 13px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--kc-muted);
      margin: 0;
    }

    .kc-crumbs a {
      color: var(--kc-muted);
    }

    .kc-crumbs .kc-crumb-sep {
      opacity: 0.5;
    }

    /* ---------- blog index hero ---------- */

    .kc-blog-hero {
      max-width: var(--kc-wrap);
      margin: 0 auto;
      padding: 72px var(--kc-gut) 44px;
    }

    .kc-blog-hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
      gap: 56px;
      align-items: end;
      margin-top: 28px;
    }

    .kc-blog-hero h1 {
      margin: 0;
      font-size: 68px;
      line-height: 1.02;
      letter-spacing: -0.035em;
      font-weight: 500;
      text-wrap: balance;
    }

    .kc-blog-hero-grid > p {
      margin: 0 0 10px;
      font-size: 18px;
      line-height: 1.6;
      color: var(--kc-body);
      max-width: 44ch;
      text-wrap: pretty;
    }

    /* ---------- featured post ---------- */

    .kc-featured-wrap {
      max-width: var(--kc-wrap);
      margin: 0 auto;
      padding: 0 var(--kc-gut) 20px;
    }

    .kc-featured {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
      background: var(--kc-green);
      border-radius: 24px;
      overflow: hidden;
      color: #fbfbf8;
      transition: background-color 200ms ease;
    }

    .kc-featured:hover {
      background: var(--kc-green-deep);
      color: #ffffff;
      text-decoration: none;
    }

    .kc-featured-body {
      padding: 56px;
      display: flex;
      flex-direction: column;
      gap: 22px;
      justify-content: center;
    }

    .kc-featured-meta {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
      font-family: var(--kc-mono);
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      opacity: 0.78;
    }

    .kc-featured-badge {
      padding: 6px 12px;
      border: 1px solid rgba(251, 251, 248, 0.4);
      border-radius: 999px;
      opacity: 1;
    }

    .kc-featured h2 {
      margin: 0;
      font-size: 42px;
      line-height: 1.1;
      letter-spacing: -0.025em;
      color: #ffffff;
      font-weight: 500;
      text-wrap: balance;
    }

    .kc-featured-body > p {
      margin: 0;
      font-size: 17px;
      line-height: 1.65;
      opacity: 0.82;
      max-width: 52ch;
      text-wrap: pretty;
    }

    .kc-featured-read {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-size: 15px;
      font-weight: 600;
      color: #ffffff;
      margin-top: 6px;
    }

    .kc-featured-media {
      min-height: 420px;
      background-color: #0d5138;
      background-image: repeating-linear-gradient(
        135deg,
        rgba(251, 251, 248, 0.09) 0 10px,
        rgba(251, 251, 248, 0) 10px 20px
      );
    }

    .kc-featured-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* ---------- CTA band (shared by index and article) ---------- */

    .kc-cta {
      max-width: var(--kc-wrap);
      margin: 0 auto;
      padding: 80px var(--kc-gut) 96px;
    }

    .kc-cta-inner {
      border-top: 1px solid var(--kc-rule-14);
      padding-top: 56px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 48px;
      align-items: center;
    }

    .kc-cta h2 {
      font-size: 36px;
      line-height: 1.12;
      font-weight: 500;
      letter-spacing: -0.028em;
      margin: 16px 0;
      max-width: 18em;
      text-wrap: balance;
    }

    .kc-cta p {
      font-size: 17px;
      line-height: 1.65;
      color: var(--kc-body);
      max-width: 46ch;
      margin: 0 0 26px;
      text-wrap: pretty;
    }

    .kc-cta-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .kc-cta-actions .kc-btn,
    .kc-cta-actions .kc-btn-ghost {
      padding: 14px 24px;
      font-size: 15px;
      font-weight: 600;
    }

    .kc-cta-media {
      border-radius: 20px;
      overflow: hidden;
      background-color: var(--kc-tint);
      background-image: var(--kc-hatch);
      aspect-ratio: 16 / 9;
    }

    .kc-cta-media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* ---------- tablet ---------- */

    @media (max-width: 900px) {
      .kc-cta {
        padding-top: 56px;
        padding-bottom: 64px;
      }

      .kc-cta-inner {
        grid-template-columns: 1fr;
        gap: 32px;
        padding-top: 40px;
      }

      .kc-cta h2 {
        font-size: 30px;
      }

      .kc-blog-hero {
        padding-top: 48px;
        padding-bottom: 32px;
      }

      .kc-blog-hero-grid {
        grid-template-columns: 1fr;
        gap: 24px;
        align-items: start;
        margin-top: 20px;
      }

      .kc-blog-hero h1 {
        font-size: 48px;
      }

      .kc-featured {
        grid-template-columns: 1fr;
      }

      /* Design puts the photo above the copy on narrow screens. */
      .kc-featured-media {
        order: -1;
        min-height: 0;
        height: 220px;
      }

      .kc-featured-body {
        padding: 32px 28px 36px;
      }

      .kc-featured h2 {
        font-size: 30px;
      }
    }

    /* The nav labels stop fitting beside the brand and the CTA at roughly
       768px, same as the homepage. */
    @media (max-width: 768px) {
      .kc-nav-links {
        display: none;
      }

      .kc-nav .kc-btn {
        margin-left: auto;
      }
    }

    @media (max-width: 600px) {
      :root {
        --kc-gut: 20px;
      }

      .kc-nav {
        gap: 12px;
      }

      .kc-brand {
        font-size: 15px;
      }

      .kc-nav .kc-btn {
        margin-left: auto;
        min-height: 44px;
        display: flex;
        align-items: center;
      }

      .kc-eyebrow,
      .kc-crumbs {
        font-size: 12px;
      }

      .kc-footer-inner {
        padding: 24px var(--kc-gut);
        font-size: 14px;
      }

      .kc-footer-links {
        margin-left: 0;
        gap: 16px;
      }

      .kc-blog-hero {
        padding-top: 32px;
      }

      .kc-blog-hero h1 {
        font-size: 36px;
        line-height: 1.08;
      }

      .kc-blog-hero-grid > p {
        font-size: 16px;
      }

      .kc-featured {
        border-radius: 18px;
      }

      .kc-featured-media {
        height: 180px;
      }

      .kc-featured-body {
        padding: 26px 22px 30px;
      }

      .kc-featured h2 {
        font-size: 26px;
      }
    }
  </style>
</head>
<body>
  <a class="kc-skip" href="#top">{copy.skip}</a>

  <header class="kc-header">
    <nav class="kc-nav" aria-label={copy.navLabel}>
      <a href={isEnglish ? '/en/' : '/'} class="kc-brand">^Kunke Consulting</a>
      <div class="kc-nav-links">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={item.current ? 'page' : undefined}>
              {item.label}
            </a>
          ))
        }
        <a
          href={otherBlogUrl}
          hreflang={isEnglish ? 'pl' : 'en'}
          lang={isEnglish ? 'pl' : 'en'}
        >
          {copy.switchLabel}
        </a>
      </div>
      <a href="mailto:info@kunkeconsulting.pl" class="kc-btn">{copy.cta}</a>
    </nav>
  </header>

  <main id="top">
    <slot />
  </main>

  <footer class="kc-footer">
    <div class="kc-footer-inner">
      <p>© 2026 ^Kunke Consulting</p>
      <div class="kc-footer-links">
        <a href={blogIndexUrl}>Blog</a>
        <a href="/privacy-policy/">{copy.privacy}</a>
        <a href="/ai-info/">{copy.robots}</a>
        <a href={otherBlogUrl} hreflang={isEnglish ? 'pl' : 'en'} lang={isEnglish ? 'pl' : 'en'}>
          {copy.switchLabel}
        </a>
      </div>
    </div>
  </footer>
</body>
</html>
