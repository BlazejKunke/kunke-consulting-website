---
// English blog index — mirrors src/pages/blog/index.astro on the redesign from
// the Claude Design project "Blog ^Kunke Consulting.dc.html". Keep the two in
// sync. Article pages themselves are shared and live under /blog/<slug>/.

import { getCollection } from 'astro:content';
import BlogShell from '../../../components/BlogShell.astro';
import BlogPostGrid from '../../../components/BlogPostGrid.astro';
import type { GridPost } from '../../../utils/blog';
import { blogCategories, categoryLabel, formatDate, readingTimeLabel, resolveCategory } from '../../../utils/blog';

const nonce: string | undefined = Astro.locals?.nonce;

const posts = (await getCollection('blog'))
  .filter((post) => post.data.language === 'en')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const [featured, ...rest] = posts;

const toGridPost = (post: (typeof posts)[number]): GridPost => {
  const category = resolveCategory(post.data);
  return {
    href: `/blog/${post.slug}/`,
    title: post.data.title,
    excerpt: post.data.description,
    date: formatDate(post.data.date, 'en'),
    isoDate: post.data.date.toISOString(),
    category,
    categoryLabel: categoryLabel(category, 'en'),
    image: post.data.heroImage
  };
};

const gridPosts = rest.map(toGridPost);

const filters = [
  { key: 'all', label: categoryLabel('all', 'en') },
  ...blogCategories
    .filter((category) => gridPosts.some((post) => post.category === category))
    .map((category) => ({ key: category, label: categoryLabel(category, 'en') }))
];

const featuredCategory = featured ? resolveCategory(featured.data) : 'practice';

const siteUrl = Astro.site ?? new URL('https://kunkeconsulting.pl');
const canonicalUrl = 'https://kunkeconsulting.pl/en/blog/';
const pageTitle = 'Practical AI for business | ^Kunke Consulting Blog';
const pageDescription =
  'Field notes from AI rollouts, tests of new models, and lessons from workshops. What actually works inside companies, and what stayed stuck in a pilot.';
const ogImage = new URL('/images/Workshop2025.JPG', siteUrl).href;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://kunkeconsulting.pl/en/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: canonicalUrl }
  ]
};

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: '^Kunke Consulting Blog',
  description: pageDescription,
  url: canonicalUrl,
  inLanguage: 'en-US',
  publisher: { '@type': 'Organization', name: 'Kunke Consulting', url: 'https://kunkeconsulting.pl/' },
  blogPost: posts.slice(0, 10).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.date.toISOString(),
    url: `https://kunkeconsulting.pl/blog/${post.slug}/`,
    author: { '@type': 'Person', name: 'Błażej Kunke' }
  }))
};
---

<BlogShell
  lang="en"
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
>
  <Fragment slot="head">
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="pl-PL" href="https://kunkeconsulting.pl/blog/" />
    <link rel="alternate" hreflang="x-default" href="https://kunkeconsulting.pl/blog/" />
    <script type="application/ld+json" nonce={nonce} set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" nonce={nonce} set:html={JSON.stringify(blogSchema)} />
  </Fragment>

  <section class="kc-blog-hero">
    <p class="kc-crumbs">
      <a href="/en/">Home</a>
      <span class="kc-crumb-sep" aria-hidden="true">/</span>
      <span aria-current="page">Blog</span>
    </p>
    <div class="kc-blog-hero-grid">
      <h1>Practical AI for business</h1>
      <p>
        Field notes from AI rollouts, tests of new models, and lessons from workshops. What actually
        works inside companies, and what stayed stuck in a pilot.
      </p>
    </div>
  </section>

  {
    featured && (
      <section class="kc-featured-wrap" aria-labelledby="kc-featured-title">
        <a class="kc-featured" href={`/blog/${featured.slug}/`}>
          <div class="kc-featured-body">
            <div class="kc-featured-meta">
              <span class="kc-featured-badge">Featured</span>
              <span>
                {formatDate(featured.data.date, 'en')} · {readingTimeLabel(featured.body, 'en')} ·{' '}
                {categoryLabel(featuredCategory, 'en')}
              </span>
            </div>
            <h2 id="kc-featured-title">{featured.data.title}</h2>
            <p>{featured.data.description}</p>
            <span class="kc-featured-read">
              Read the article <span aria-hidden="true">&#8594;</span>
            </span>
          </div>
          <div class="kc-featured-media">
            {featured.data.heroImage && (
              <img
                src={featured.data.heroImage}
                alt=""
                loading="eager"
                fetchpriority="high"
                decoding="async"
                width="600"
                height="450"
              />
            )}
          </div>
        </a>
      </section>
    )
  }

  <BlogPostGrid
    posts={gridPosts}
    filters={filters}
    heading="All articles"
    filtersLabel="Filter articles by category"
    showMoreLabel="Show all articles"
    showLessLabel="Show fewer"
    readLabel="Read"
  />

  <section class="kc-cta" aria-labelledby="kc-blog-cta-title">
    <div class="kc-cta-inner">
      <div>
        <p class="kc-eyebrow">From reading to doing</p>
        <h2 id="kc-blog-cta-title">Ready to move from reading to doing?</h2>
        <p>
          An AI training session is the natural first step. An AI rollout is a program built around
          your team and your processes.
        </p>
        <div class="kc-cta-actions">
          <a class="kc-btn" href="/en/#offer">See the offer</a>
          <a class="kc-btn-ghost" href="mailto:info@kunkeconsulting.pl">Email me</a>
        </div>
      </div>
      <div class="kc-cta-media">
        <img
          src="/images/Workshop2025.JPG"
          alt="An AI workshop run by ^Kunke Consulting"
          loading="lazy"
          decoding="async"
          width="800"
          height="450"
        />
      </div>
    </div>
  </section>
</BlogShell>
