---
// Article template, shared by Polish and English posts — the redesign imported
// from the Claude Design project "Blog ^Kunke Consulting.dc.html". A dark green
// title band, an overlapping hero image, a single measured column of prose, an
// author card and a "read next" row, all on the homepage's design tokens.

import { getCollection, getEntry } from 'astro:content';
import BlogShell from '../../components/BlogShell.astro';
import { categoryLabel, formatDate, readingTimeLabel, resolveCategory } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug } }));
}


const { slug } = Astro.params;
const post = await getEntry('blog', slug as string);
if (!post) throw new Error(`Post "${slug}" not found`);

const { Content } = await post.render();

const isEnglish = post.data.language === 'en';
const lang: 'pl' | 'en' = isEnglish ? 'en' : 'pl';
const category = resolveCategory(post.data);

const heroImage = post.data.heroImage;
const absoluteHeroImage = heroImage
  ? heroImage.startsWith('http')
    ? heroImage
    : `https://kunkeconsulting.pl${heroImage}`
  : 'https://kunkeconsulting.pl/images/Workshop2025.JPG';

const canonicalUrl = `https://kunkeconsulting.pl/blog/${slug}/`;
const blogIndexUrl = isEnglish ? '/en/blog/' : '/blog/';
const homeUrl = isEnglish ? '/en/' : '/';

const labels = isEnglish
  ? {
      home: 'Home',
      blog: 'Blog',
      readNext: 'Read next',
      authorBio:
        'Founder of ^Kunke Consulting. After 10+ years at Franklin Templeton Investments and McKinsey & Company, he runs practical AI training and rollouts for companies in Poland and Europe.',
      ctaEyebrow: 'From reading to doing',
      ctaTitle: 'Ready to move from reading to doing?',
      ctaBody:
        'An AI training session is the natural first step. An AI rollout is a program built around your team and your processes.',
      ctaPrimary: 'See the offer',
      ctaPrimaryHref: '/en/#offer',
      ctaSecondary: 'Email me',
      ctaSecondaryHref: 'mailto:info@kunkeconsulting.pl',
      ctaAlt: 'An AI workshop run by ^Kunke Consulting'
    }
  : {
      home: 'Strona główna',
      blog: 'Blog',
      readNext: 'Czytaj dalej',
      authorBio:
        'Założyciel ^Kunke Consulting. Po 10+ latach w Franklin Templeton Investments i McKinsey & Company prowadzi praktyczne szkolenia i wdrożenia AI w polskich firmach.',
      ctaEyebrow: 'Od teorii do wdrożenia',
      ctaTitle: 'Chcesz przejść z czytania do robienia?',
      ctaBody:
        'Szkolenie AI dla firm to naturalny pierwszy krok. Wdrożenie AI to program szyty na miarę zespołu i procesów.',
      ctaPrimary: 'Zobacz ofertę AI dla firm',
      ctaPrimaryHref: '/#oferta',
      ctaSecondary: 'Napisz do mnie',
      ctaSecondaryHref: 'mailto:info@kunkeconsulting.pl',
      ctaAlt: 'Warsztat AI prowadzony przez ^Kunke Consulting'
    };

// Read next: same language, same category first, then the newest of the rest.
const siblings = (await getCollection('blog'))
  .filter((entry) => entry.slug !== post.slug && (entry.data.language ?? 'pl') === (post.data.language ?? 'pl'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const sameCategory = siblings.filter((entry) => resolveCategory(entry.data) === category);
const related = [...sameCategory, ...siblings.filter((entry) => !sameCategory.includes(entry))].slice(0, 3);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: labels.home, item: `https://kunkeconsulting.pl${homeUrl}` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `https://kunkeconsulting.pl${blogIndexUrl}` },
    { '@type': 'ListItem', position: 3, name: post.data.title, item: canonicalUrl }
  ]
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: absoluteHeroImage,
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  articleSection: categoryLabel(category, lang),
  author: {
    '@type': 'Person',
    name: 'Błażej Kunke',
    url: 'https://www.linkedin.com/in/blazejkunke/'
  },
  publisher: {
    '@type': 'Organization',
    name: 'Kunke Consulting',
    logo: { '@type': 'ImageObject', url: 'https://kunkeconsulting.pl/images/Kunke_Favicon.png' }
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  keywords: post.data.tags
    ? post.data.tags.join(', ')
    : isEnglish
      ? 'AI, artificial intelligence, AI training'
      : 'AI, sztuczna inteligencja, szkolenia AI'
};
---

<BlogShell
  lang={lang}
  title={post.data.seoTitle ?? `${post.data.title} | Blog - ^Kunke Consulting`}
  description={post.data.description}
  canonicalUrl={canonicalUrl}
  ogImage={absoluteHeroImage}
  ogType="article"
>
  <Fragment slot="head">
    {/*
      No hreflang. A post exists in one language only — nothing in the content
      files records that, say, the Polish and English "American government
      blocked the best AI model" posts are the same article. Until a post can
      declare its translation, a self-referencing tag claims a language group of
      one, which is noise. Linking a pair means registering it in
      src/utils/locales.ts, not hand-writing tags here.
    */}
    <meta property="article:published_time" content={post.data.date.toISOString()} />
    <meta property="article:author" content="Błażej Kunke" />
    <meta property="article:section" content={categoryLabel(category, lang)} />
    {post.data.tags?.map((tag: string) => <meta property="article:tag" content={tag} />)}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  </Fragment>

  <header class="kc-article-head">
    <div class="kc-article-head-inner">
      <p class="kc-crumbs kc-crumbs-invert">
        <a href={blogIndexUrl}>{labels.blog}</a>
        <span class="kc-crumb-sep" aria-hidden="true">/</span>
        <span>{categoryLabel(category, lang)}</span>
      </p>
      <h1>{post.data.title}</h1>
      <p class="kc-article-standfirst">{post.data.description}</p>
      <div class="kc-byline">
        <img
          class="kc-byline-avatar"
          src="/images/blazej-kunke-hero.jpg"
          alt=""
          loading="lazy"
          decoding="async"
          width="44"
          height="44"
        />
        <span>
          Błażej Kunke · <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
          · {readingTimeLabel(post.body, lang)}
        </span>
      </div>
    </div>
  </header>

  {
    /* No hero image means no frame at all — an empty hatch block here is dead
       space, unlike the grid cards where it keeps the rows even. */
    heroImage && (
      <div class="kc-article-hero">
        <div class="kc-article-hero-frame">
          <img
            src={heroImage}
            alt={post.data.title}
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="900"
            height="380"
          />
        </div>
      </div>
    )
  }

  <article class="kc-prose">
    <Content />
  </article>

  <section class="kc-author" aria-label="Błażej Kunke">
    <div class="kc-author-card">
      <img
        class="kc-author-avatar"
        src="/images/blazej-kunke-hero.jpg"
        alt=""
        loading="lazy"
        decoding="async"
        width="84"
        height="84"
      />
      <div>
        <p class="kc-author-name">Błażej Kunke</p>
        <p class="kc-author-bio">{labels.authorBio}</p>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="kc-related" aria-labelledby="kc-related-title">
        <h2 id="kc-related-title">{labels.readNext}</h2>
        <div class="kc-related-grid">
          {related.map((entry) => (
            <a class="kc-related-item" href={`/blog/${entry.slug}/`}>
              <div class="kc-related-media">
                {entry.data.heroImage && (
                  <img
                    src={entry.data.heroImage}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="360"
                    height="130"
                  />
                )}
              </div>
              <span class="kc-related-date">{formatDate(entry.data.date, lang)}</span>
              <h3>{entry.data.title}</h3>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <section class="kc-cta" aria-labelledby="kc-article-cta-title">
    <div class="kc-cta-inner">
      <div>
        <p class="kc-eyebrow">{labels.ctaEyebrow}</p>
        <h2 id="kc-article-cta-title">{labels.ctaTitle}</h2>
        <p>{labels.ctaBody}</p>
        <div class="kc-cta-actions">
          <a class="kc-btn" href={labels.ctaPrimaryHref}>{labels.ctaPrimary}</a>
          <a class="kc-btn-ghost" href={labels.ctaSecondaryHref}>{labels.ctaSecondary}</a>
        </div>
      </div>
      <div class="kc-cta-media">
        <img
          src="/images/Workshop2025.JPG"
          alt={labels.ctaAlt}
          loading="lazy"
          decoding="async"
          width="800"
          height="450"
        />
      </div>
    </div>
  </section>
</BlogShell>

<style is:global>
  /* ---------- article title band ---------- */

  .kc-article-head {
    background: var(--kc-green);
    color: #fbfbf8;
  }

  .kc-article-head-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 72px var(--kc-gut) 64px;
  }

  .kc-crumbs-invert,
  .kc-crumbs-invert a {
    color: rgba(251, 251, 248, 0.72);
  }

  .kc-crumbs-invert a:hover {
    color: #ffffff;
  }

  .kc-article-head h1 {
    margin: 26px 0 22px;
    font-size: 52px;
    line-height: 1.05;
    letter-spacing: -0.032em;
    color: #ffffff;
    font-weight: 500;
    text-wrap: balance;
  }

  .kc-article-standfirst {
    margin: 0 0 30px;
    font-size: 19px;
    line-height: 1.6;
    opacity: 0.82;
    max-width: 60ch;
    text-wrap: pretty;
  }

  .kc-byline {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 14px;
    opacity: 0.88;
  }

  .kc-byline-avatar {
    width: 44px;
    height: 44px;
    border-radius: 999px;
    object-fit: cover;
    object-position: 50% 22%;
    background: #0d5138;
  }

  /* ---------- overlapping hero image ---------- */

  .kc-article-hero {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 var(--kc-gut);
  }

  .kc-article-hero-frame {
    height: 380px;
    margin-top: -36px;
    border-radius: 20px;
    overflow: hidden;
    background-color: var(--kc-tint);
    background-image: var(--kc-hatch);
    box-shadow: 0 24px 48px -28px rgba(10, 71, 49, 0.45);
  }

  .kc-article-hero-frame img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- prose ---------- */

  .kc-prose {
    max-width: 720px;
    margin: 0 auto;
    padding: 56px var(--kc-gut) 24px;
    font-size: 19px;
    line-height: 1.75;
    color: #243b32;
  }

  .kc-prose > :first-child {
    margin-top: 0;
  }

  .kc-prose p {
    margin: 0 0 26px;
    text-wrap: pretty;
  }

  /* The page h1 is the title band, so a body h1 is a mistake in the markdown.
     Style it like an h2 rather than letting the browser default through. */
  .kc-prose h1 {
    margin: 44px 0 16px;
    font-size: 30px;
    line-height: 1.2;
    letter-spacing: -0.022em;
    color: var(--kc-green);
    font-weight: 500;
  }

  .kc-prose h2 {
    margin: 44px 0 16px;
    font-size: 30px;
    line-height: 1.2;
    letter-spacing: -0.022em;
    color: var(--kc-green);
    font-weight: 500;
    text-wrap: balance;
  }

  .kc-prose h3 {
    margin: 34px 0 12px;
    font-size: 23px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--kc-green);
    font-weight: 600;
    text-wrap: balance;
  }

  .kc-prose h4 {
    margin: 28px 0 10px;
    font-size: 19px;
    color: var(--kc-green);
    font-weight: 600;
  }

  .kc-prose ul,
  .kc-prose ol {
    margin: 0 0 26px;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .kc-prose li::marker {
    color: var(--kc-muted);
  }

  .kc-prose blockquote {
    margin: 36px 0;
    padding: 26px 30px;
    border-radius: 18px;
    background: #efede5;
    font-size: 21px;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--kc-green);
  }

  .kc-prose blockquote p:last-child {
    margin-bottom: 0;
  }

  .kc-prose a {
    color: var(--kc-green);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--kc-rule-42);
  }

  .kc-prose a:hover {
    text-decoration-color: var(--kc-green);
  }

  .kc-prose img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 16px;
    margin: 32px 0;
  }

  .kc-prose hr {
    border: 0;
    border-top: 1px solid var(--kc-rule-14);
    margin: 44px 0;
  }

  .kc-prose code {
    font-family: var(--kc-mono);
    font-size: 0.86em;
    background: var(--kc-tint);
    border-radius: 6px;
    padding: 2px 6px;
  }

  .kc-prose pre {
    background: var(--kc-green);
    color: #fbfbf8;
    border-radius: 16px;
    padding: 22px 24px;
    overflow-x: auto;
    margin: 0 0 26px;
    font-size: 15px;
    line-height: 1.6;
  }

  .kc-prose pre code {
    background: transparent;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }

  /* Wide tables scroll inside their own box rather than the page. */
  .kc-prose table {
    display: block;
    overflow-x: auto;
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 26px;
    font-size: 16px;
  }

  .kc-prose th,
  .kc-prose td {
    border-bottom: 1px solid var(--kc-rule-14);
    padding: 12px 14px;
    text-align: left;
    vertical-align: top;
  }

  .kc-prose th {
    color: var(--kc-green);
    font-weight: 600;
  }

  .kc-prose iframe {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    height: auto;
    border: 0;
    border-radius: 16px;
    margin: 32px 0;
  }

  /* ---------- author card ---------- */

  .kc-author {
    max-width: 720px;
    margin: 0 auto;
    padding: 16px var(--kc-gut) 0;
  }

  .kc-author-card {
    border: 1px solid var(--kc-rule-18);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    gap: 22px;
    align-items: center;
  }

  .kc-author-avatar {
    width: 84px;
    height: 84px;
    flex: 0 0 84px;
    border-radius: 16px;
    object-fit: cover;
    object-position: 50% 22%;
    background-color: var(--kc-tint);
    background-image: var(--kc-hatch);
  }

  .kc-author-name {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 6px;
  }

  .kc-author-bio {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--kc-body);
    text-wrap: pretty;
  }

  /* ---------- read next ---------- */

  .kc-related {
    max-width: var(--kc-wrap);
    margin: 0 auto;
    padding: 72px var(--kc-gut) 0;
  }

  .kc-related h2 {
    margin: 0 0 24px;
    font-family: var(--kc-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--kc-green);
    border-bottom: 1px solid var(--kc-rule-14);
    padding-bottom: 18px;
  }

  .kc-related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  .kc-related-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--kc-ink);
  }

  .kc-related-item:hover {
    text-decoration: none;
  }

  .kc-related-item:hover h3 {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .kc-related-media {
    height: 130px;
    border-radius: 14px;
    overflow: hidden;
    background-color: var(--kc-tint);
    background-image: var(--kc-hatch);
  }

  .kc-related-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kc-related-date {
    font-family: var(--kc-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--kc-muted);
  }

  .kc-related-item h3 {
    margin: 0;
    font-size: 20px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    font-weight: 500;
    text-wrap: pretty;
  }

  /* ---------- tablet ---------- */

  @media (max-width: 900px) {
    .kc-article-head-inner {
      padding: 48px var(--kc-gut) 48px;
    }

    .kc-article-head h1 {
      font-size: 38px;
      margin-top: 20px;
    }

    .kc-article-standfirst {
      font-size: 17px;
    }

    .kc-article-hero-frame {
      height: 260px;
    }

    .kc-prose {
      padding-top: 40px;
      font-size: 18px;
    }

    .kc-prose h2 {
      font-size: 26px;
      margin-top: 36px;
    }

    .kc-related {
      padding-top: 56px;
    }

    .kc-related-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .kc-related-media {
      height: 180px;
    }
  }

  /* ---------- phone ---------- */

  @media (max-width: 600px) {
    .kc-article-head-inner {
      padding: 32px var(--kc-gut) 40px;
    }

    .kc-article-head h1 {
      font-size: 30px;
    }

    .kc-article-standfirst {
      font-size: 16px;
      margin-bottom: 24px;
    }

    .kc-article-hero-frame {
      height: 190px;
      margin-top: -24px;
      border-radius: 16px;
    }

    .kc-prose {
      padding-top: 32px;
      font-size: 17px;
    }

    .kc-prose blockquote {
      padding: 20px 22px;
      font-size: 18px;
    }

    .kc-author-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
      padding: 22px;
    }
  }
</style>
